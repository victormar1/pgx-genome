#!/bin/sh
# Controles avant tout push : tests du module, controles du depot, et
# validation des messages de commit qui partent. La CI
# (.github/workflows/ci.yml) rejoue les memes controles a distance.
#
# Active par : git config core.hooksPath outils/crochets
# Contournable par : git push --no-verify   (a n'utiliser qu'en connaissance)
set -e
R=$(git rev-parse --show-toplevel)
cd "$R"

# Sous WSL, python3 porte pypgx et permet de verifier la regeneration des
# ressources ; sous Git bash, python suffit pour le reste.
#
# Un interpreteur present n'est pas un interpreteur utilisable : sous Windows,
# command -v trouve un lanceur du Microsoft Store qui existe et refuse de
# s'executer : le hook echouerait sans avoir rien verifie. On l'essaie donc
# avant de le retenir.
PY=python
if command -v python3 >/dev/null 2>&1 && python3 -c "" >/dev/null 2>&1; then
  PY=python3
fi

echo "--- tests du module ---"
"$PY" -m unittest discover -s tests -q

echo "--- controles du depot ---"
"$PY" outils/verifier_depot.py

echo "--- messages de commit qui partent ---"
while read -r locale_ref locale_sha distante_ref distante_sha; do
  [ "$locale_sha" = "0000000000000000000000000000000000000000" ] && continue
  case "$distante_sha" in
    0000000000000000000000000000000000000000) plage="$locale_sha" ;;
    *) plage="$distante_sha..$locale_sha" ;;
  esac
  n=0
  for c in $(git rev-list --max-count=50 "$plage"); do
    f=$(mktemp)
    git log -1 --format=%B "$c" > "$f"
    if ! "$PY" outils/valider_message.py "$f"; then
      echo "  commit $(git log -1 --format=%h "$c") refuse"
      rm -f "$f"
      exit 1
    fi
    rm -f "$f"
    n=$((n+1))
  done
  echo "  $n message(s) conformes"
done

echo "--- controles passes ---"
